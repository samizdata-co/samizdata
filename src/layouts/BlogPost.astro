---
// Blog post page — content column on top of the shared Base shell.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { defaultLang, useTranslations } from '../i18n';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
---

<Base title={title} description={description}>
	<main>
		<article>
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
			</div>
			<div class="prose">
				<div class="title">
					{pubDate && (
						<div class="date">
							<FormattedDate date={pubDate} locale={lang} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{t('last.updated')} <FormattedDate date={updatedDate} locale={lang} />
									</div>
								)
							}
						</div>
					)}
					<h1>{title}</h1>
					<hr />
				</div>
				<slot />
			</div>
		</article>
	</main>
</Base>

<style>
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 0;
	}
	.prose {
		width: min(720px, 100%);
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1rem var(--section-block);
		color: var(--muted);
	}
	.title {
		margin-bottom: 2rem;
		padding: var(--section-block-tight) 0 1.5rem;
		text-align: center;
		line-height: 0.95;
	}
	.title h1 {
		margin: 0 0 1rem;
	}
	.date {
		margin-bottom: 1.5rem;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: var(--text-label-sm);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}
	.last-updated-on {
		font-style: italic;
		margin-top: 0.75rem;
		letter-spacing: 0;
		text-transform: none;
	}
</style>
