---
// Blog post page — content column on top of the shared Base shell.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MoreStories from '../components/MoreStories.astro';
import { getLanguage, useTranslations } from '../i18n';
import { blogAlternates, getPosts } from '../lib/blog';

interface Props {
	title: string;
	description: string;
	date?: Date;
	'date-modified'?: Date;
	image?: ImageMetadata;
	translationGroup?: string;
	postId?: string;
}

const { title, description, date, 'date-modified': dateModified, image, translationGroup, postId } = Astro.props;
const lang = getLanguage(Astro.currentLocale);
const alternates = date ? await blogAlternates(translationGroup) : undefined;
const morePosts = date && postId
	? (await getPosts(lang)).filter((post) => post.id !== postId).slice(0, 3)
	: [];
const t = useTranslations(lang);
---

<Base
	{title}
	{description}
	image={image}
	imageAlt={title}
	type={date ? 'article' : 'website'}
	publishedTime={date}
	updatedTime={dateModified}
	{alternates}
>
	<main>
		<article class:list={{ 'has-more-stories': morePosts.length > 0 }}>
			<div class="hero-image">
				{image && <Image width={1020} height={510} src={image} alt="" priority />}
			</div>
			<div class="prose">
				<div class="title">
					{date && (
						<div class="date">
							<FormattedDate date={date} locale={lang} />
							{
								dateModified && (
									<div class="last-updated-on">
										{t('last.updated')} <FormattedDate date={dateModified} locale={lang} />
									</div>
								)
							}
						</div>
					)}
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<hr />
				</div>
				<slot />
			</div>
		</article>
		{morePosts.length > 0 && <MoreStories posts={morePosts} locale={lang} />}
	</main>
</Base>

<style>
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 0;
	}
	.prose {
		width: min(720px, 100%);
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1rem var(--section-block);
		color: var(--muted);
	}
	.has-more-stories .prose {
		padding-bottom: var(--section-block-tight);
	}
	.title {
		margin-bottom: 2rem;
		padding: var(--section-block-tight) 0 1.5rem;
		text-align: center;
		line-height: 0.95;
	}
	.title h1 {
		margin: 0 0 1rem;
	}
	.description {
		max-width: 38rem;
		margin: 0 auto 1.5rem;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 3vw, 1.5rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}
	.date {
		margin-bottom: 1.5rem;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: var(--text-label-sm);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}
	.last-updated-on {
		font-style: italic;
		margin-top: 0.75rem;
		letter-spacing: 0;
		text-transform: none;
	}
</style>
