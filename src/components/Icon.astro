---
// Inline Lucide icon set (ISC-licensed paths, ported from @lucide/svelte 1.8.0
// as used by the original website). No icon dependency needed.
interface Props {
	name:
		| 'file-search'
		| 'chart-no-axes-combined'
		| 'database'
		| 'graduation-cap'
		| 'arrow-right'
		| 'arrow-up-right'
		| 'menu'
		| 'x'
		| 'moon'
		| 'sun'
		| 'chevron-down';
	size?: number;
	strokeWidth?: number;
	class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
