---
import { getTrainingNav, getTrainingPages } from '../../lib/training';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const nav = getTrainingNav(await getTrainingPages());
const norm = (path: string) => path.replace(/\/+$/, '');
const currentPath = norm(Astro.url.pathname);
---

<section class="training-article section-block-tight">
	<div class="shell">
		<div class="article-column">
			<header>
				<p class="eyebrow muted">Open Training Library</p>
				<h1>{title}</h1>
				<p class="description">{description}</p>
			</header>

			<aside>
				{
					nav.map((section, index) => (
						<div class:list={['nav-section', { divided: index > 0 }]}>
							<h2>{section.title}</h2>
							<nav aria-label={section.title} class="training-link-nav">
								{section.items.map((item) => {
									const active = currentPath === norm(item.href);
									return (
										<a class:list={{ active }} href={item.href} aria-current={active ? 'page' : undefined}>
											{item.title}
										</a>
									);
								})}
							</nav>
						</div>
					))
				}
			</aside>

			<article class="prose"><slot /></article>
		</div>
	</div>
</section>

<style>
	.training-article {
		padding-top: clamp(8rem, 12vw, 10rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
		background: var(--color-surface-low);
	}
	.article-column {
		width: min(100%, 56rem);
		min-width: 0;
		margin-inline: auto;
	}
	header {
		margin-bottom: 1rem;
		padding-top: 0.5rem;
	}
	header h1 {
		margin: 0.35rem 0 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.06em;
	}
	.description {
		max-width: 42rem;
		margin-top: 0.85rem;
		color: var(--color-muted);
		font-size: 1.1rem;
		line-height: 1.6;
	}
	aside {
		margin-bottom: 1.25rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-low);
	}
	.nav-section.divided {
		margin-top: 1.4rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--color-border-soft);
	}
	.nav-section h2 {
		margin: 0 0 0.7rem;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.training-link-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-lowest);
		color: var(--color-muted);
		font-size: 0.875rem;
		line-height: 1.25rem;
		text-decoration: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease;
	}
	.training-link-nav a:hover {
		border-color: var(--color-border-accent);
		color: var(--color-accent-text-hover);
	}
	.training-link-nav a.active {
		border-color: var(--color-border-accent);
		background: var(--color-primary-glow);
		color: var(--color-accent-text);
		font-weight: 700;
	}
	.prose {
		padding: clamp(1.5rem, 3vw, 3rem);
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-lowest);
	}
</style>
