---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/samizdata-social.jpg';
import { getLanguage, useTranslations } from '../i18n';
import { Font, getImage } from 'astro:assets';
import { siteConfig } from '../lib/site';
import { serializeJsonLd, type LocaleAlternate } from '../lib/metadata';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	canonical?: boolean;
	robots?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	updatedTime?: Date;
	alternates?: LocaleAlternate[];
}

const lang = getLanguage(Astro.currentLocale);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image = FallbackImage,
	imageAlt = title,
	canonical = true,
	robots,
	type = 'website',
	publishedTime,
	updatedTime,
	alternates = [],
} = Astro.props;
const brandedTitle = title === siteConfig.name ? title : `${title} • ${siteConfig.name}`;
const socialImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'webp' });
const socialImageURL = new URL(socialImage.src, Astro.site);
const organization = {
	'@type': 'Organization',
	name: siteConfig.name,
	legalName: siteConfig.legalName,
	url: siteConfig.url,
	email: siteConfig.email,
	sameAs: [siteConfig.linkedinUrl],
};
const structuredData = type === 'article'
	? {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		image: socialImageURL.href,
		datePublished: publishedTime?.toISOString(),
		dateModified: (updatedTime ?? publishedTime)?.toISOString(),
		mainEntityOfPage: canonicalURL.href,
		author: organization,
		publisher: organization,
	}
	: { '@context': 'https://schema.org', ...organization };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Apply theme before first paint: stored choice, else system preference -->
<script is:inline>
	(function () {
		try {
			var stored = localStorage.getItem('samizdata-theme');
			var theme =
				stored === 'light' || stored === 'dark'
					? stored
					: window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			document.documentElement.dataset.theme = theme;
		} catch (e) {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
<link rel="shortcut icon" href="/favicon-32x32.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf9f4" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111311" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={t('site.title')}
	href={new URL(lang === 'ro' ? 'ro/rss.xml' : 'rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-space-grotesk" preload={[{ weight: 700, subset: 'latin' }]} />
<Font cssVariable="--font-work-sans" />

<!-- Canonical and translated equivalents -->
{canonical && <link rel="canonical" href={canonicalURL} />}
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
{alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={alternates.find(({ lang }) => lang === 'en')?.href} />}

<!-- Primary Meta Tags -->
<title>{brandedTitle}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_GB'} />
{alternates.filter(({ lang: alternateLang }) => alternateLang !== lang).map(({ lang: alternateLang }) => (
	<meta property="og:locale:alternate" content={alternateLang === 'ro' ? 'ro_RO' : 'en_GB'} />
))}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={brandedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={brandedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
