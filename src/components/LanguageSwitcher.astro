---
// Single-button language switcher — mirrors the theme toggle (44px circular
// icon button) and navigates to the other-locale page for the same route.
// Shows the flag of the language you'll switch *to*, with an accessible
// label naming the target. It is only rendered when an equivalent page exists.
import type { LocaleAlternate } from '../lib/metadata';

interface Props {
	alternate: LocaleAlternate;
	altLabel: string;
	altFlag: string;
}

const { alternate, altLabel, altFlag } = Astro.props;
const alternatePath = new URL(alternate.href).pathname;
---

<a href={alternatePath} data-lang-href class="lang-switcher" lang={alternate.lang} hreflang={alternate.lang} aria-label={altLabel}>
	<span aria-hidden="true" class="flag">{altFlag}</span>
</a>

<style>
	.lang-switcher {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		padding: 0;
		border: 1px solid var(--color-border-soft);
		border-radius: 9999px;
		background: var(--color-surface-lowest);
		color: var(--color-ink-soft);
		text-decoration: none;
		cursor: pointer;
		transition:
			color 0.18s ease,
			border-color 0.18s ease,
			background-color 0.18s ease;
	}
	.lang-switcher:hover {
		color: var(--color-accent-text);
		border-color: var(--color-border-accent);
		background: var(--color-surface-high);
	}
	.flag {
		font-size: 1.1rem;
		line-height: 1;
	}
</style>

<script>
	// Keep the current #anchor when switching language
	document.querySelectorAll('[data-lang-href]').forEach((a) => {
		const href = a.getAttribute('href') || '';
		const hash = window.location.hash;
		if (hash) {
			a.setAttribute('href', href.replace(/#.*$/, '') + hash);
		}
	});
</script>