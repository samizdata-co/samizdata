---
// Single-button language switcher — mirrors the theme toggle (44px circular
// icon button) and navigates to the other-locale page for the same route.
// Shows the flag of the language you'll switch *to*, with an accessible
// label naming the target. A blog post not translated there falls back to
// the other-language home instead of a 404 link.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getPosts } from '../lib/blog';
import type { Language } from '../i18n';

interface Props {
	lang: Language;
	altLabel: string;
	altFlag: string;
}

const { lang, altLabel, altFlag } = Astro.props;
const altLang: Language = lang === 'ro' ? 'en' : 'ro';

const norm = Astro.url.pathname.replace(/\/+$/, '') || '/';
const path = norm === `/${lang}` ? '/' : norm.startsWith(`/${lang}/`) ? norm.slice(lang.length + 1) : norm;
let altHref = path === '/' ? getRelativeLocaleUrl(altLang, '/') : getRelativeLocaleUrl(altLang, path);

if (path.startsWith('/blog/')) {
	const slug = path.split('/blog/')[1];
	const posts = await getPosts(altLang);
	if (!slug || !posts.some((p) => p.id === `${altLang}/${slug}`)) {
		altHref = getRelativeLocaleUrl(altLang, '/');
	}
}
---

<a href={altHref} data-lang-href class="lang-switcher" lang={altLang} aria-label={altLabel}>
	<span aria-hidden="true" class="flag">{altFlag}</span>
</a>

<style>
	.lang-switcher {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		padding: 0;
		border: 1px solid var(--color-border-soft);
		border-radius: 9999px;
		background: var(--color-surface-lowest);
		color: var(--color-ink-soft);
		text-decoration: none;
		cursor: pointer;
		transition:
			color 0.18s ease,
			border-color 0.18s ease,
			background-color 0.18s ease;
	}
	.lang-switcher:hover {
		color: var(--color-primary);
		border-color: var(--color-border-accent);
		background: var(--color-surface-high);
	}
	.flag {
		font-size: 1.1rem;
		line-height: 1;
	}
</style>

<script>
	// Keep the current #anchor when switching language
	document.querySelectorAll('[data-lang-href]').forEach((a) => {
		const href = a.getAttribute('href') || '';
		const hash = window.location.hash;
		if (hash) {
			a.setAttribute('href', href.replace(/#.*$/, '') + hash);
		}
	});
</script>