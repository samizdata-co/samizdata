---
// Article card — ported from ArticleCard.svelte. Media card with a dark
// gradient overlay: eyebrow meta (publication · year) + headline.
import CardShell from './CardShell.astro';
import PortfolioMedia from './PortfolioMedia.astro';
import type { ArticleCardData } from '../../lib/portfolio';
import { isExternalHref } from '../../lib/cv';

interface Props {
	card: ArticleCardData;
}

const { card } = Astro.props;
const external = isExternalHref(card.href);
---

<CardShell
	class="article-card"
	href={card.href}
	hreflang={card.href && !external ? 'en' : undefined}
	target={external ? '_blank' : undefined}
	rel={external ? 'noreferrer' : undefined}
	variant="media"
>
	{card.image && (
		<PortfolioMedia
			image={card.image}
			alt={card.headline}
			fetchpriority="low"
			widths={[320, 640, 960]}
			sizes="(min-width: 1200px) 22rem, (min-width: 640px) 50vw, 100vw"
		/>
	)}
	<div class="overlay">
		<div class="meta eyebrow">
			<span>{card.publication}</span>
			<span>{card.year}</span>
		</div>
		<div class="content">
			<h3>{card.headline}</h3>
		</div>
	</div>
</CardShell>

<style>
	:global(.article-card) {
		display: flex;
		color: #fff;
	}
	img,
	video,
	.overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	img,
	video {
		object-fit: cover;
		transition: transform 600ms ease;
	}
	.overlay {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.75rem;
		background: linear-gradient(180deg, rgba(12, 13, 12, 0.42) 0%, rgba(12, 13, 12, 0.96) 100%);
	}
	:global(.card-shell:hover .article-card) img,
	:global(.card-shell:hover .article-card) video {
		transform: scale(1.04);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 1rem;
		color: rgba(255, 255, 255, 0.96);
		text-shadow: 0 0.1rem 0.6rem rgba(0, 0, 0, 0.5);
	}
	.content {
		display: flex;
		align-items: end;
		min-height: 100%;
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2vw, 1.8rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		color: #fff;
		text-shadow: 0 0.15rem 0.8rem rgba(0, 0, 0, 0.55);
	}
</style>