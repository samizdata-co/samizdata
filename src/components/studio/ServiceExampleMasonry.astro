---
// Service example masonry — ported from ServiceExampleMasonry.svelte, but
// CSS-only (column-count) instead of the JS column-balancing version. Used
// for the Visualisation service. Items render as link/overlay media or a
// plain fallback copy block when there's no image.
import PortfolioMedia from './PortfolioMedia.astro';
import type { ServiceExample } from '../../lib/services';
import { isExternalHref } from '../../lib/cv';

interface Props {
	examples: ServiceExample[];
}

const { examples } = Astro.props;
// CSS columns fill top-to-bottom, so only the first item is reliably at the
// top of the gallery; it is the LCP element on mobile. Everything else lazy-loads.
// Slot widths mirror .shell (1440px max, 2rem/1rem side gutters) and the
// 1 → 2 → 3 column layout with 1rem gaps below.
const sizes =
	'(min-width: 1504px) 29.5rem, (min-width: 1120px) calc((100vw - 6rem) / 3), (min-width: 760px) calc((100vw - 5rem) / 2), (min-width: 641px) calc(100vw - 4rem), calc(100vw - 2rem)';
---

<div class="example-masonry">
	{examples.map((example, index) => {
		const Tag = example.href ? 'a' : 'article';
		const external = isExternalHref(example.href);
		const loading = index === 0 ? 'eager' : 'lazy';
		return (
		<Tag
			class="gallery-item"
			href={example.href ?? undefined}
			hreflang={example.href && !external ? 'en' : undefined}
			target={external ? '_blank' : undefined}
			rel={external ? 'noreferrer' : undefined}
		>
			{example.image ? (
				<>
					<PortfolioMedia
						image={example.image}
						alt=""
						loading={loading}
						fetchpriority={index === 0 ? 'high' : undefined}
						widths={[320, 480, 720, 960]}
						sizes={sizes}
					/>
					<div class="overlay">
						<div class="meta eyebrow">
							{example.source && <span>{example.source}</span>}
							{example.year && <span>{example.year}</span>}
						</div>
						<h3>{example.title}</h3>
					</div>
				</>
			) : (
				<div class="fallback-copy">
					<div class="meta eyebrow">
						{example.source && <span>{example.source}</span>}
						{example.year && <span>{example.year}</span>}
					</div>
					<h3>{example.title}</h3>
				</div>
			)}
		</Tag>
		);
	})}
</div>

<style>
	.example-masonry {
		columns: 1;
		column-gap: 1rem;
	}
	.gallery-item {
		position: relative;
		display: block;
		width: 100%;
		margin-bottom: 1rem;
		break-inside: avoid;
		overflow: clip;
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-highest);
		text-decoration: none;
		transition:
			transform 220ms ease,
			box-shadow 220ms ease,
			border-color 220ms ease;
	}
	.gallery-item:hover {
		transform: translateY(-0.2rem);
		box-shadow: var(--shadow-ambient);
		border-color: var(--color-border-accent);
	}
	.gallery-item:focus-visible {
		outline-offset: 4px;
	}
	img,
	video {
		display: block;
		width: 100%;
		height: auto;
		background: var(--color-surface-highest);
		transition: transform 600ms ease;
	}
	.overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem;
		color: white;
		background: linear-gradient(
			180deg,
			rgba(12, 13, 12, 0.2) 0%,
			rgba(12, 13, 12, 0.84) 100%
		);
		pointer-events: none;
	}
	.gallery-item:hover img,
	.gallery-item:hover video,
	.gallery-item:focus-visible img,
	.gallery-item:focus-visible video {
		transform: scale(1.02);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 0.8rem;
		color: rgba(255, 255, 255, 0.96);
		text-shadow: 0 0.1rem 0.6rem rgba(0, 0, 0, 0.5);
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2vw, 1.8rem);
		font-weight: 900;
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: white;
		text-shadow: 0 0.15rem 0.8rem rgba(0, 0, 0, 0.55);
	}
	.fallback-copy {
		display: grid;
		gap: 0.9rem;
		min-height: 14rem;
		padding: 1.25rem;
		background: var(--color-surface-lowest);
	}
	.fallback-copy .meta {
		color: var(--color-accent-text);
		text-shadow: none;
	}
	.fallback-copy h3 {
		color: var(--color-ink);
		text-shadow: none;
	}
	@media (min-width: 760px) {
		.example-masonry {
			columns: 2;
		}
	}
	@media (min-width: 1120px) {
		.example-masonry {
			columns: 3;
		}
	}
</style>