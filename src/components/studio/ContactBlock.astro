---
// Contact block — ported from ContactBlock.svelte. Large email tile that
// inverts to raspberry on hover, plus LinkedIn and location tiles.
import Icon from '../Icon.astro';
import { siteConfig } from '../../lib/site';

interface Props {
	title: string;
	body: string;
	emailLabel: string;
	locationLabel: string;
	location: string;
	socialLabel: string;
}

const { title, body, emailLabel, locationLabel, location, socialLabel } = Astro.props;
---

<section class="contact section-block" id="contact">
	<div class="shell grid grid-cols-1 items-start gap-12 min-[900px]:grid-cols-[minmax(0,1fr)_minmax(24rem,36rem)] min-[900px]:gap-16">
		<div class="intro">
			<h2 class="section-title mb-8">{title}</h2>
			<p class="body-copy max-w-128">{body}</p>
		</div>

		<div class="grid gap-5">
			<a
				class="email-tile group"
				href={`mailto:${siteConfig.email}`}
			>
				<div class="min-w-0">
					<span class="eyebrow mb-[0.6rem] block text-[var(--color-primary-container)] group-hover:text-white/76">
						{emailLabel}
					</span>
					<strong class="font-[var(--font-display)] text-[clamp(1.6rem,6vw,3rem)] font-black tracking-[-0.06em] break-words text-inherit">
						{siteConfig.email}
					</strong>
				</div>
				<Icon name="arrow-up-right" size={36} strokeWidth={2.1} />
			</a>

			<div class="grid grid-cols-1 gap-5 min-[641px]:grid-cols-2">
				<div class="info-tile">
					<span class="eyebrow muted">{socialLabel}</span>
					<p class="mt-[0.9rem] font-[var(--font-display)] text-[2rem] font-black tracking-[-0.04em] text-[var(--color-ink)]">
						<a
							class="underline decoration-[var(--color-primary-container)] underline-offset-[0.5rem]"
							href={siteConfig.linkedinUrl}
							target="_blank"
							rel="noreferrer"
							>LinkedIn</a
						>
					</p>
				</div>
				<div class="info-tile">
					<span class="eyebrow muted">{locationLabel}</span>
					<p class="mt-[0.9rem] font-[var(--font-display)] text-[2rem] font-black tracking-[-0.04em] text-[var(--color-ink)]">
						{location}
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: var(--color-surface);
	}
	.email-tile {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 2rem;
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-low);
		color: var(--color-ink);
		text-decoration: none;
		transition:
			background-color 0.22s ease,
			color 0.22s ease,
			transform 0.22s ease,
			border-color 0.22s ease;
	}
	.email-tile:hover {
		transform: translateY(-0.15rem);
		border-color: var(--color-primary);
		background: var(--color-primary-container);
		color: #fff;
	}
	.info-tile {
		padding: 2rem;
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface-high);
		color: var(--color-ink);
	}
	.info-tile a {
		text-decoration-color: var(--color-primary-container);
		text-underline-offset: 0.5rem;
	}
	@media (max-width: 640px) {
		.email-tile,
		.info-tile {
			padding: 2rem;
		}
		.email-tile {
			gap: 1rem;
		}
	}
</style>