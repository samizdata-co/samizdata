---
// Servicii — versiunea în română a /services (index).
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import ServiceCard from '../../../components/studio/ServiceCard.astro';
import ContactBlock from '../../../components/studio/ContactBlock.astro';
import '../../../styles/studio.css';
import { useTranslations } from '../../../i18n';
import { getServices } from '../../../lib/services';

const lang = 'ro';
const t = useTranslations(lang);
const services = getServices(lang);

const serviceCards = services.map((service) => ({
	title: service.name,
	description: service.summary,
	icon: service.icon,
	href: getRelativeLocaleUrl(lang, `/services/${service.slug}`),
	cta: t('services.browseCta'),
}));

const trainingCard = {
	title: t('services.trainingTitle'),
	description: t('services.trainingDescription'),
	icon: 'graduation-cap' as const,
	href: '#contact',
	label: t('services.trainingCta'),
	variant: 'accent' as const,
};
---

<Base title={t('services.seo.title')} description={t('services.seo.description')}>
	<main class="studio-main services-home">
		<section class="hero section-block-tight">
			<div class="hero-noise" aria-hidden="true"></div>
			<div class="shell hero-grid">
				<div class="hero-copy">
					<h1 class="display-title">{t('services.title')}</h1>
					<p class="body-copy intro">{t('services.intro')}</p>
				</div>
			</div>
		</section>

		<section class="catalogue section-block-tight" id="services-grid">
			<div class="shell">
				<div class="service-grid">
					{serviceCards.map((card) => (
						<div>
							<ServiceCard card={card} />
						</div>
					))}

					<div>
						<ServiceCard card={trainingCard} />
					</div>
				</div>
			</div>
		</section>

		<ContactBlock
			title={t('studio.contact.title')}
			body={t('studio.contact.body')}
			emailLabel={t('studio.contact.email')}
			locationLabel={t('studio.contact.locationLabel')}
			location={t('studio.contact.location')}
			socialLabel={t('studio.contact.social')}
		/>
	</main>
</Base>

<style>
	.services-home {
		background:
			radial-gradient(circle at top left, var(--color-primary-glow), transparent 34%),
			var(--color-surface);
	}
	.hero {
		position: relative;
		overflow: clip;
		padding-top: 6rem;
	}
	.hero-noise {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(115deg, rgba(255, 255, 255, 0.06), transparent 36%),
			repeating-linear-gradient(
				90deg,
				transparent 0,
				transparent 1.8rem,
				rgba(255, 255, 255, 0.03) 1.8rem,
				rgba(255, 255, 255, 0.03) 1.86rem
			);
		opacity: 0.45;
		pointer-events: none;
	}
	.hero-grid,
	.service-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}
	.hero-grid {
		align-items: start;
		padding-top: clamp(1.25rem, 4vw, 3rem);
	}
	.hero-copy {
		max-width: 52rem;
	}
	.intro {
		margin-top: 1.25rem;
		max-width: 45rem;
	}
	.catalogue {
		padding-top: 0;
	}
	@media (min-width: 720px) {
		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1200px) {
		.service-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>