---
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import HomepageStudioPromo from '../../components/HomepageStudioPromo.astro';
import { getLanguage, useTranslations } from '../../i18n';

const lang = getLanguage(Astro.currentLocale);
const t = useTranslations(lang);
---

<Base title={t('site.title')} description={t('site.description')}>
	<main>
		<BlogList locale="ro" />
		<HomepageStudioPromo />
	</main>
</Base>
