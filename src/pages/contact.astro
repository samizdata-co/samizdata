---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/studio/ContactBlock.astro';
import '../styles/studio.css';
import { useTranslations } from '../i18n';

const t = useTranslations('en');
---

<Base title={t('contact.seo.title')} description={t('contact.seo.description')}>
	<main class="studio-main contact-page">
		<ContactBlock
			title={t('studio.contact.title')}
			body={t('studio.contact.body')}
			emailLabel={t('studio.contact.email')}
			locationLabel={t('studio.contact.locationLabel')}
			location={t('studio.contact.location')}
			socialLabel={t('studio.contact.social')}
			standalone
		/>
		<section class="cal-booking section-block" aria-labelledby="booking-title">
			<div class="shell">
				<header class="booking-header">
					<div>
						<p class="eyebrow booking-eyebrow">30-minute consultation</p>
						<h2 class="booking-title" id="booking-title">Book a conversation</h2>
					</div>
					<p class="body-copy booking-copy">
						Choose a time that works for you. We can discuss your project, an investigation, training,
						or another way to work together.
					</p>
				</header>
				<div class="cal-frame">
					<div style="width:100%;height:100%;overflow:scroll" id="my-cal-inline-30min"></div>
				</div>
			</div>
		</section>
	</main>

	<script is:inline src="/cal-embed.js"></script>
</Base>

<style>
	.contact-page {
		min-height: 100vh;
		padding-top: var(--nav-offset);
		background: var(--color-surface);
	}
	.cal-booking {
		background: var(--color-surface-low);
	}
	.booking-header {
		display: grid;
		gap: 2rem;
		margin-bottom: 4rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border-strong);
	}
	.booking-eyebrow {
		margin-bottom: 1rem;
		color: var(--color-accent-text);
	}
	.booking-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 900;
		letter-spacing: -0.05em;
		line-height: 0.92;
	}
	.booking-copy {
		align-self: end;
	}
	.cal-frame {
		border: 1px solid var(--color-border-soft);
		background: var(--color-surface);
	}
	@media (min-width: 900px) {
		.booking-header {
			grid-template-columns: minmax(0, 5fr) minmax(20rem, 7fr);
		}
	}
</style>
