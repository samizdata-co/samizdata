{
  "name": "samizdata",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/sync-cv.mjs && astro dev",
    "check": "node scripts/sync-cv.mjs && astro check --minimumFailingSeverity warning",
    "build": "npm run check && astro build",
    "test:dist": "node scripts/check-dist.mjs",
    "verify": "npm run build && npm run test:dist",
    "brand:sync": "cp ../brand/css/tokens.css src/styles/vendor/samizdata/tokens.css",
    "brand:check": "cmp ../brand/css/tokens.css src/styles/vendor/samizdata/tokens.css",
    "cv:sync": "node scripts/sync-cv.mjs",
    "smoke": "node scripts/smoke-deployment.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "^0.3.5",
    "astro-pagefind": "^2.0.1",
    "typescript": "6.0.2"
  }
}
